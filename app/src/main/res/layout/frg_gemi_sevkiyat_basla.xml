<?xml version="1.0" encoding="utf-8"?>
<AbsoluteLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/colorBlack"
    android:focusable="false"
    tools:context="com.etimaden.GemiIslemleri.frg_gemi_sevkiyat_basla">

    <TextView
        android:id="@+id/textView24"
        android:layout_width="325dp"
        android:layout_height="wrap_content"
        android:layout_x="0dp"
        android:layout_y="0dp"
        android:textColor="@color/green"
        android:text="frg_gemi_sevkiyat_basla"
        android:textSize="12dp" />

    <TextView
        android:id="@+id/txtgemiSevkBaslik"
        android:layout_width="325dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:layout_x="0dp"
        android:layout_y="20dp"
        android:gravity="center_horizontal|center_vertical"
        android:text="Aktif İşemirleri Listesi"
        android:textAlignment="center"
        android:textColor="@color/green"
        android:textSize="15dp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btngemiSevkGeri"
        android:layout_width="325dp"
        android:layout_height="50dp"
        android:layout_x="0dp"
        android:layout_y="500dp"
        android:background="@drawable/my_button_cikis"
        android:gravity="center"
        android:textSize="20sp"
        android:focusable="false"
        android:text=" &lt; &lt; GERİ"
        android:textColor="@color/colorRed" />

    <Button
        android:id="@+id/btngemiSevkIleri"
        android:layout_width="325dp"
        android:layout_height="60dp"
        android:layout_x="0dp"
        android:layout_y="65dp"
        android:background="@drawable/btn_menu_normal"
        android:focusable="false"
        android:gravity="center"
        android:text="İLERİ"
        android:textColor="@color/green"
        android:textSize="20sp" />

    <HorizontalScrollView
        android:layout_width="325dp"
        android:layout_height="300dp"
        android:layout_x="2dp"
        android:layout_y="141dp">

        <ListView
            android:id="@+id/teslimat_list"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:listSelector="@color/colorBlackSecili"
            android:scrollbars="horizontal|vertical"
            android:textColor="@color/green" />
    </HorizontalScrollView>
</AbsoluteLayout>